# Server (opsional; default backend listen di 0.0.0.0:3001)
# PORT=3001
# HOST=0.0.0.0

# PostgreSQL — WAJIB untuk go-live (backend tidak menggunakan mock)
DB_HOST=localhost
DB_PORT=5432
DB_USER=cmms_userv3
DB_PASSWORD=your_password
DB_NAME=cmms_dbv3

# Atau gunakan satu URL (disarankan):
# DATABASE_URL=postgresql://cmms_userv3:your_password@localhost:5432/cmms_dbv3

# Login web — pilih salah satu:
# (A) Multi-user PostgreSQL: jalankan migration-cmms-app-users.sql, lalu:
#     npm run user:create -- <username> <password> ["Nama tampilan"]
#     atau daftarkan pengguna pertama lewat POST /api/auth/register (hanya saat belum ada user).
# (B) Satu akun dari env (legacy):
# CMMS_AUTH_USERNAME=admin
# CMMS_AUTH_PASSWORD=ganti-password-kuat
#
# CMMS_AUTH_SECRET wajib diganti di production (menandatangani JWT). Beberapa perangkat boleh login
# bersamaan dengan akun yang sama (tiap login = token baru, tanpa sesi tunggal di server).
# CMMS_AUTH_SECRET=ubah-dengan-secret-acak-minimal-32-karakter

# Setelah buat user & database, jalankan schema lalu grant:
#   psql -d cmms_dbv3 -f database/schema-postgres.sql
#   sudo -u postgres psql -d cmms_dbv3 -f database/grant-permissions-cmms_dbv3.sql
#   (opsional) psql -d cmms_dbv3 -f database/seed-postgres.sql
